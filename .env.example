# 1) Copy this file and name the copy exactly:  .env
# 2) Put YOUR PostgreSQL details below.
# NEVER put real passwords in this example file – only in .env (which git ignores).

# --- Local PostgreSQL -------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=renalcare

# --- OR a hosted database (Render, Neon, Supabase, Railway ...) -------
# If DATABASE_URL is set it is used instead of the PG* values above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random text (16+ characters). It signs the login tokens.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-any-long-random-text

PORT=3000

# --- Optional ---------------------------------------------------------
# SEED_DEMO=false          # true (default) = first start also adds demo patients/doctors/data
# ADMIN_PASSWORD=          # password for the first 'admin' login (random + printed if blank in production)
# ALLOW_SIGNUP=false       # turn off public patient sign-up
# PGSSL=true               # force SSL on/off (auto-on for hosted DATABASE_URL)
